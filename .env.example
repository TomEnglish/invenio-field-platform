EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# The office site of the same environment as the database above (no trailing slash)
EXPO_PUBLIC_OFFICE_SITE_URL=https://your-office-site.example.com

# Only when the database above is a dev environment's: that environment's label, as its office site shows it.
# It gives the app its own name and app ID and the "Dev" label on screen. Leave it out for a production.
# EXPO_PUBLIC_ENVIRONMENT_LABEL=Dev
