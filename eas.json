{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "channel": "production"
    },
    "dev-store": {
      "extends": "preview",
      "distribution": "store"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761624622"
      }
    },
    "dev-store": {
      "ios": {
        "appName": "Invenio Field Dev"
      }
    }
  }
}
